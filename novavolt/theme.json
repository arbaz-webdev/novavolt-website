{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "min(880px, 90vw)",
      "wideSize": "min(1680px, 92vw)"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "palette": [
        { "slug": "base", "color": "#FFFFFF", "name": "White" },
        { "slug": "surface", "color": "#F1F7FC", "name": "Surface" },
        { "slug": "contrast", "color": "#0C2A45", "name": "Ink" },
        { "slug": "navy", "color": "#123C63", "name": "Navy" },
        { "slug": "navy-deep", "color": "#0C2C4A", "name": "Deep Navy" },
        { "slug": "primary", "color": "#2B7FC4", "name": "NovaVolt Blue" },
        { "slug": "primary-bright", "color": "#4FA3DE", "name": "Bright Blue" },
        { "slug": "accent", "color": "#86CDEA", "name": "Cloud Accent" },
        { "slug": "muted", "color": "#64748B", "name": "Slate" },
        { "slug": "border", "color": "#DEE9F3", "name": "Border" }
      ],
      "gradients": [
        { "slug": "brand", "gradient": "linear-gradient(135deg, #2B7FC4 0%, #4FA3DE 100%)", "name": "Brand" },
        { "slug": "brand-deep", "gradient": "linear-gradient(135deg, #2B7FC4 0%, #123C63 100%)", "name": "Brand Deep" },
        { "slug": "hero", "gradient": "linear-gradient(180deg, #0C2C4A 0%, #123C63 100%)", "name": "Hero" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.9rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.15rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "XL", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
        { "slug": "xx-large", "name": "2XL", "size": "2.5rem", "fluid": { "min": "2rem", "max": "3rem" } },
        { "slug": "huge", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.6rem", "max": "4.25rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.75rem" },
        { "slug": "30", "name": "S", "size": "1.25rem" },
        { "slug": "40", "name": "M", "size": "2rem" },
        { "slug": "50", "name": "L", "size": "3.25rem" },
        { "slug": "60", "name": "XL", "size": "5rem" },
        { "slug": "70", "name": "2XL", "size": "7rem" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65",
      "fontWeight": "400"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "1.25rem", "right": "1.25rem" }
    },
    "elements": {
      "heading": {
        "typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" },
        "color": { "text": "var(--wp--preset--color--navy)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--primary-bright)" } }
      },
      "button": {
        "border": { "radius": "10px" },
        "spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
        "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" },
        "color": { "background": "var(--wp--preset--color--primary)", "text": "#ffffff" }
      }
    },
    "blocks": {
      "core/heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--sans)" } },
      "core/site-title": {
        "typography": { "fontSize": "1.35rem", "fontWeight": "800", "letterSpacing": "-0.03em" },
        "color": { "text": "var(--wp--preset--color--navy)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Full Width Page", "postTypes": ["page"] }
  ]
}
